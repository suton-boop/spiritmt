<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory browsing
    Options -Indexes

    # Block access to hidden files (.env, .git, etc.)
    <FilesMatch "^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # Rewrite all requests to the public/ folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
